{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/course.json", "destination": "/api/course?key=course.json" },
    { "source": "/solutions.json", "destination": "/api/course?key=solutions.json" },
    { "source": "/api/word", "destination": "/api/course?key=word" },
    { "source": "/api/version", "destination": "/build.json" },
    { "source": "/media/:file", "destination": "/api/course?key=media/:file" },
    { "source": "/assets/books/:book/:page", "destination": "/api/course?key=assets/books/:book/:page" },
    { "source": "/assets/text/:book/:page", "destination": "/api/course?key=assets/text/:book/:page" },
    { "source": "/assets/book-audio/:file", "destination": "/api/course?key=assets/book-audio/:file" },
    { "source": "/assets/audio/:group/:file", "destination": "/api/course?key=assets/audio/:group/:file" },
    { "source": "/assets/audio/:file", "destination": "/api/course?key=assets/audio/:file" },
    { "source": "/assets/words/:file", "destination": "/api/course?key=assets/words/:file" },
    { "source": "/assets/dictionary/:file", "destination": "/api/course?key=assets/dictionary/:file" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
    ] }
  ]
}
